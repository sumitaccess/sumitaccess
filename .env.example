# API
PORT=4000
NODE_ENV=development

# Production persistence (the local API currently uses seeded in-memory data)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/haatly
SESSION_SECRET=replace-with-a-long-random-secret

# Maps — use Mapbox or an OpenStreetMap-compatible provider in production
MAP_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=

# Indian payments — never commit real values
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Notifications
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
