# ------------------------------------------------------------------
# SkillSwap environment configuration
# Copy this file to .env and adjust values. NEVER commit real secrets.
# ------------------------------------------------------------------

# Database. SQLite is used for the local demo/dev environment so the app
# runs with zero external services. To deploy on PostgreSQL, change the
# datasource provider in prisma/schema.prisma to "postgresql" and set a
# postgres:// connection string here (the schema is written to be portable).
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="skillswap-dev-secret-change-me-in-production-0123456789abcdef"

# Optional Google OAuth (remove/leave blank to hide the Google button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Demo account password used by the seeder and the "Try the demo" button.
# Set a strong value in production.
DEMO_PASSWORD="demo1234"

# Optional: Resend-style email provider (SMTP-compatible). Leave blank to
# keep the app fully functional with a mock email sink in development.
EMAIL_FROM="SkillSwap <no-reply@skillswap.app>"
RESEND_API_KEY=""
NEXT_PUBLIC_DEMO_PASSWORD="demo1234"
