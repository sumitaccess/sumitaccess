// ============================================================================
// SkillSwap — database schema
// ----------------------------------------------------------------------------
// The schema is written to be portable between SQLite (local demo/dev, zero
// external services) and PostgreSQL (production). Enum-like fields are stored
// as String and validated at the application layer with Zod + the constants in
// lib/constants.ts. To deploy on PostgreSQL, set `provider = "postgresql"` and
// a postgres:// DATABASE_URL — no model changes are required.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id               String   @id @default(cuid())
  name             String
  username         String   @unique
  email            String   @unique
  passwordHash     String?
  image            String?
  bio              String?
  headline         String?
  location         String?
  timezone         String   @default("Asia/Kolkata")
  languages        String   @default("English") // comma separated
  availability     String? // JSON weekly schedule, e.g. {"mon":["18:00-21:00"]}
  onlinePref       String   @default("ONLINE") // ONLINE | IN_PERSON | BOTH
  credits          Int      @default(0)
  rating           Float    @default(0)
  totalReviews     Int      @default(0)
  completedSessions Int     @default(0)
  hoursTaught      Int      @default(0)
  role             String   @default("USER") // USER | MODERATOR | ADMIN
  status           String   @default("ACTIVE") // ACTIVE | SUSPENDED
  verified         Boolean  @default(false)
  resetToken       String?
  resetTokenExpiry DateTime?
  emailVerified    DateTime?
  lastActiveAt     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userSkills           UserSkill[]
  sessionsTeaching     Session[]        @relation("SessionTeacher")
  sessionsLearning     Session[]        @relation("SessionLearner")
  reviewsGiven         Review[]         @relation("Reviewer")
  reviewsReceived      Review[]         @relation("Reviewed")
  creditTransactions   CreditTransaction[]
  notifications        Notification[]
  messagesSent         Message[]
  conversationsAsA     Conversation[]   @relation("ConversationUserA")
  conversationsAsB     Conversation[]   @relation("ConversationUserB")
  matchesAsA           Match[]          @relation("MatchUserA")
  matchesAsB           Match[]          @relation("MatchUserB")
  reportsMade          Report[]         @relation("Reporter")
  reportsReceived      Report[]         @relation("Reported")

  @@index([status, role])
}

// ---------------------------------------------------------------------------
// Skills
// ---------------------------------------------------------------------------

model Skill {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String // TECHNOLOGY | DESIGN | BUSINESS | LANGUAGES | MUSIC | FITNESS | PHOTOGRAPHY | GIS | FINANCE | MARKETING | LIFESTYLE
  description String?
  icon        String? // lucide icon name
  color       String? // accent hue class
  popularity  Int      @default(0)
  createdAt   DateTime @default(now())

  userSkills UserSkill[]
  sessions   Session[]

  @@index([category, popularity])
}

// ---------------------------------------------------------------------------
// UserSkills — what a user teaches / wants to learn
// ---------------------------------------------------------------------------

model UserSkill {
  id              String  @id @default(cuid())
  userId          String
  skillId         String
  type            String // TEACH | LEARN
  level           String  @default("INTERMEDIATE") // BEGINNER | INTERMEDIATE | ADVANCED | EXPERT
  yearsExperience Int     @default(0)
  description     String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId, type])
  @@index([skillId, type])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Matches — a pair of users matched by the compatibility engine
// ---------------------------------------------------------------------------

model Match {
  id                  String   @id @default(cuid())
  userAId             String
  userBId             String
  compatibilityScore  Int      @default(0)
  status              String   @default("PENDING") // PENDING | ACCEPTED | REJECTED | BLOCKED
  requestedSkillId    String? // skill userA wants to learn from userB
  offeredSkillId      String? // skill userA offers to teach userB
  requestMessage      String?
  respondedAt         DateTime?
  createdAt           DateTime @default(now())

  userA           User   @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB           User   @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  requestedSkill  Skill? @relation("MatchRequestedSkill", fields: [requestedSkillId], references: [id])
  offeredSkill    Skill? @relation("MatchOfferedSkill", fields: [offeredSkillId], references: [id])

  @@unique([userAId, userBId])
  @@index([userBId, status])
}

// ---------------------------------------------------------------------------
// Sessions — booked skill exchange sessions
// ---------------------------------------------------------------------------

model Session {
  id          String   @id @default(cuid())
  teacherId   String
  learnerId   String
  skillId     String
  title       String?
  description String?
  startTime   DateTime
  endTime     DateTime
  duration    Int // minutes
  status      String   @default("REQUESTED") // REQUESTED | CONFIRMED | COMPLETED | CANCELLED | DISPUTED
  credits     Int      @default(1)
  sessionType String   @default("ONLINE") // ONLINE | IN_PERSON
  meetingUrl  String?
  location    String?
  cancelledBy String?
  cancelReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher  User  @relation("SessionTeacher", fields: [teacherId], references: [id])
  learner  User  @relation("SessionLearner", fields: [learnerId], references: [id])
  skill    Skill @relation(fields: [skillId], references: [id])
  reviews  Review[]
  creditsSent CreditTransaction[]

  @@index([teacherId, status])
  @@index([learnerId, status])
  @@index([startTime])
}

// ---------------------------------------------------------------------------
// Conversations & messages
// ---------------------------------------------------------------------------

model Conversation {
  id            String   @id @default(cuid())
  userAId       String
  userBId       String
  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userA     User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([userAId, userBId])
  @@index([updatedAt])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  attachment     String?
  attachmentType String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id           String   @id @default(cuid())
  sessionId    String
  reviewerId   String
  reviewedId   String
  rating       Int // 1..5
  comment      String?
  tags         String? // comma separated: Helpful, Friendly, Knowledgeable...
  createdAt    DateTime @default(now())

  session  Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewer User    @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewed User    @relation("Reviewed", fields: [reviewedId], references: [id], onDelete: Cascade)

  @@unique([sessionId, reviewerId])
  @@index([reviewedId])
}

// ---------------------------------------------------------------------------
// Credits — every credit movement is a transaction; the balance is derived
// from and kept in sync with these rows.
// ---------------------------------------------------------------------------

model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  amount       Int // +earn / -spend
  type         String // EARNED | SPENT | BONUS | REFUND | ADMIN_ADJUSTMENT
  description  String
  balanceAfter Int
  sessionId    String?
  createdAt    DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // MATCH | SWAP_REQUEST | REQUEST_ACCEPTED | MESSAGE | SESSION_REMINDER | SESSION_COMPLETED | REVIEW | CREDIT | SYSTEM
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

// ---------------------------------------------------------------------------
// Reports & disputes (safety & trust)
// ---------------------------------------------------------------------------

model Report {
  id           String    @id @default(cuid())
  reporterId   String
  reportedUserId String
  sessionId    String?
  type         String    @default("USER") // USER | SESSION
  reason       String
  details      String?
  status       String    @default("OPEN") // OPEN | RESOLVED | DISMISSED
  adminNote    String?
  createdAt    DateTime  @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([status])
}
