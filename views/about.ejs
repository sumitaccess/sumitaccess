<%- include('partials/header') %>

<section class="page-hero">
  <div class="container">
    <span class="eyebrow">Our story</span>
    <h1 class="page-title">About Bhoomi Trust</h1>
    <p class="page-lead">A trusted marketplace for legally verified land and property across India.</p>
  </div>
</section>

<section class="section">
  <div class="container about-grid">
    <div class="about-media">
      <img src="/images/about.jpg" alt="Bhoomi Trust advisory team" loading="lazy" />
    </div>
    <div class="about-text">
      <h2 class="section-title">We verify, so you can trust.</h2>
      <p>
        Bhoomi Trust was founded on a simple promise: no family should lose their life savings to
        unclear titles or unapproved layouts. We partner with India’s most credible developers and
        subject every plot, apartment, villa and commercial space to rigorous legal and regulatory
        verification before it is ever shown to you.
      </p>
      <p>
        From RERA and DTCP approvals to revenue-record title checks and bank-loan eligibility, our
        verification layer removes the guesswork. A dedicated advisor then guides you from shortlist
        to registry — transparently, and always in your interest.
      </p>
      <ul class="check-list">
        <li>✓ 100% of listings verified before listing</li>
        <li>✓ Partnerships with 40+ trusted developers</li>
        <li>✓ Pan-India coverage across 9 states</li>
        <li>✓ Dedicated, no-obligation advisory</li>
      </ul>
      <a href="/contact" class="btn btn-gold btn-lg">Talk to an Advisor</a>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-head center">
      <div>
        <span class="eyebrow">Our values</span>
        <h2 class="section-title">What sets us apart</h2>
      </div>
    </div>
    <div class="steps-grid">
      <div class="step">
        <div class="step-num">01</div>
        <h3>Verification First</h3>
        <p>Nothing is listed until legal and regulatory checks pass.</p>
      </div>
      <div class="step">
        <div class="step-num">02</div>
        <h3>Radical Transparency</h3>
        <p>Clear pricing, clear titles, clear approvals — always.</p>
      </div>
      <div class="step">
        <div class="step-num">03</div>
        <h3>Trusted Partners</h3>
        <p>Only developers who meet our standards make the cut.</p>
      </div>
      <div class="step">
        <div class="step-num">04</div>
        <h3>Human Guidance</h3>
        <p>Real advisors, not bots, walk you through every step.</p>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
