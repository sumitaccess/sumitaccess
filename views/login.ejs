<%- include('partials/header') %>

<section class="auth-section">
  <div class="container auth-card">
    <span class="eyebrow">Welcome back</span>
    <h1 class="auth-title">Login to Bhoomi Trust</h1>
    <p class="auth-lead">Access your saved properties and enquiries.</p>

    <form id="loginForm" class="auth-form" novalidate>
      <div class="form-row">
        <label for="email">Email *</label>
        <input type="email" id="email" name="email" required placeholder="you@email.com" />
      </div>
      <div class="form-row">
        <label for="password">Password *</label>
        <input type="password" id="password" name="password" required placeholder="••••••••" />
      </div>
      <button class="btn btn-gold btn-lg" type="submit">Login</button>
      <p class="form-note" id="formNote" hidden></p>
    </form>

    <p class="auth-switch">New to Bhoomi Trust? <a href="/register">Create an account</a></p>
    <p class="auth-demo">Demo account — demo@bhoomitrust.com / demo1234</p>
  </div>
</section>

<%- include('partials/footer') %>
